<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Model builds keep running in the background (BGContinuedProcessingTask). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.marcshawco.L23D.build.*</string>
	</array>
	<!-- HQ mode: find the L23D HQ Mac app on the local network. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_l23d-hq._tcp</string>
	</array>
</dict>
</plist>
